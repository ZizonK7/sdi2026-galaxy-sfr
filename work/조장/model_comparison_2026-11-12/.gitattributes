# Preserve the line endings used by the recorded SHA256 values.
* text eol=crlf
*.py text eol=lf
*.png binary
*.npz binary
.gitignore text eol=lf
.gitattributes text eol=lf
company_review.json text eol=lf
protocol.json -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
results/protocol_snapshot.json -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
